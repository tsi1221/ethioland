// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  AGENT
  ADMIN
}

enum PropertyType {
  LAND
  HOUSE
  APARTMENT
  COMMERCIAL
  VILLA
  CONDO
}

enum PropertyStatus {
  PENDING
  APPROVED
  REJECTED
  SOLD
  RENTED
  INACTIVE
}

enum DocumentType {
  OWNERSHIP_CERTIFICATE
  TAX_CLEARANCE
  LAND_MAP
  ID_CARD
  BUSINESS_LICENSE
  OTHER
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

model User {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  email             String              @unique
  phone             String              @unique
  password          String
  firstName         String
  lastName          String
  role              UserRole            @default(BUYER)
  avatar            String?
  bio               String?
  address           String?
  city              String?
  region            String?
  isVerified        Boolean             @default(false)
  isActive          Boolean             @default(true)
  emailVerified     Boolean             @default(false)
  phoneVerified     Boolean             @default(false)
  verificationToken String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  
  // Relations
  properties        Property[]          @relation("PropertyOwner")
  agentProperties   Property[]          @relation("PropertyAgent")
  favorites         Favorite[]
  comments          Comment[]
  messages          Message[]           @relation("MessageSender")
  receivedMessages  Message[]           @relation("MessageReceiver")
  notifications     Notification[]
  transactions      Transaction[]
  documents         Document[]
  reviews           Review[]            @relation("ReviewAuthor")
  receivedReviews   Review[]            @relation("ReviewTarget")
  applications      Application[]
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model Property {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  title             String
  description       String
  type              PropertyType
  status            PropertyStatus      @default(PENDING)
  price             Float
  negotiable        Boolean             @default(false)
  currency          String              @default("ETB")
  size              Float?              // in square meters
  bedrooms          Int?
  bathrooms         Int?
  floors            Int?
  yearBuilt         Int?
  
  // Location
  address           String
  city              String
  region            String
  country           String              @default("Ethiopia")
  latitude          Float?
  longitude         Float?
  mapUrl            String?
  
  // Features
  features          String[]            // Array of features like "Parking", "Garden", etc.
  amenities         String[]            // Nearby amenities
  
  // Images and Videos
  images            String[]
  videos            String[]
  virtualTourUrl    String?
  
  // Relations
  ownerId           String              @db.ObjectId
  owner             User                @relation("PropertyOwner", fields: [ownerId], references: [id])
  agentId           String?             @db.ObjectId
  agent             User?               @relation("PropertyAgent", fields: [agentId], references: [id])
  
  documents         Document[]
  favorites         Favorite[]
  comments          Comment[]
  views             PropertyView[]
  applications      Application[]
  transactions      Transaction[]
  reviews           Review[]
  
  // Admin
  approvedBy        String?
  approvedAt        DateTime?
  rejectionReason   String?
  featured          Boolean             @default(false)
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model Document {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  type              DocumentType
  title             String
  fileUrl           String
  fileSize          Int?                // in bytes
  mimeType          String?
  
  // Relations
  propertyId        String?             @db.ObjectId
  property          Property?           @relation(fields: [propertyId], references: [id])
  userId            String?             @db.ObjectId
  user              User?               @relation(fields: [userId], references: [id])
  
  // Verification
  isVerified        Boolean             @default(false)
  verifiedBy        String?
  verifiedAt        DateTime?
  verificationNotes String?
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model Favorite {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  userId            String              @db.ObjectId
  user              User                @relation(fields: [userId], references: [id])
  propertyId        String              @db.ObjectId
  property          Property            @relation(fields: [propertyId], references: [id])
  
  createdAt         DateTime            @default(now())
  
  @@unique([userId, propertyId])
}

model Comment {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  content           String
  userId            String              @db.ObjectId
  user              User                @relation(fields: [userId], references: [id])
  propertyId        String              @db.ObjectId
  property          Property            @relation(fields: [propertyId], references: [id])
  parentId          String?             @db.ObjectId
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model Message {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  content           String
  senderId          String              @db.ObjectId
  sender            User                @relation("MessageSender", fields: [senderId], references: [id])
  receiverId        String              @db.ObjectId
  receiver          User                @relation("MessageReceiver", fields: [receiverId], references: [id])
  propertyId        String?             @db.ObjectId
  isRead            Boolean             @default(false)
  
  createdAt         DateTime            @default(now())
}

model PropertyView {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  propertyId        String              @db.ObjectId
  property          Property            @relation(fields: [propertyId], references: [id])
  viewerIp          String?
  viewerId          String?             @db.ObjectId
  
  createdAt         DateTime            @default(now())
}

model Application {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  propertyId        String              @db.ObjectId
  property          Property            @relation(fields: [propertyId], references: [id])
  userId            String              @db.ObjectId
  user              User                @relation(fields: [userId], references: [id])
  message           String?
  offerPrice        Float?
  status            String              @default("pending") // pending, accepted, rejected
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model Transaction {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  transactionId     String              @unique
  propertyId        String              @db.ObjectId
  property          Property            @relation(fields: [propertyId], references: [id])
  userId            String              @db.ObjectId
  user              User                @relation(fields: [userId], references: [id])
  amount            Float
  currency          String              @default("ETB")
  paymentMethod     String              // chapa, telebirr, cbe_birr
  status            TransactionStatus   @default(PENDING)
  paymentDetails    Json?
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model Review {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  rating            Int                 // 1-5
  comment           String?
  authorId          String              @db.ObjectId
  author            User                @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetUserId      String?             @db.ObjectId
  targetUser        User?               @relation("ReviewTarget", fields: [targetUserId], references: [id])
  propertyId        String?             @db.ObjectId
  property          Property?           @relation(fields: [propertyId], references: [id])
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model Notification {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  userId            String              @db.ObjectId
  user              User                @relation(fields: [userId], references: [id])
  title             String
  message           String
  type              String              // property_approved, new_message, new_application, etc.
  isRead            Boolean             @default(false)
  link              String?
  
  createdAt         DateTime            @default(now())
}
