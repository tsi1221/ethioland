generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  fullName        String
  email           String    @unique
  phone           String
  passwordHash    String
  role            Role      @default(BUYER)
  nationalId      String?
  kebeleId        String?
  profilePhotoUrl String?

  posts           Post[]    @relation("UserToPost")
  comments        Comment[] @relation("UserToComment")
  tokens          Token[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Post {
  id         String       @id @default(cuid())
  title      String
  price      Int
  content    String
  img        String
  address    String
  city       String
  bedroom    Int
  bathroom   Int
  latitude   String
  longitude  String
  type       Type
  property   Property

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  userId     String
  user       User         @relation("UserToPost", fields: [userId], references: [id])
  comments   Comment[]    @relation("PostToComment")
  postDetail PostDetail?
}

model Comment {
  id         String    @id @default(cuid())
  content    String
  userId     String
  postId     String

  user       User      @relation("UserToComment", fields: [userId], references: [id])
  post       Post      @relation("PostToComment", fields: [postId], references: [id])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Token {
  id         String    @id @default(cuid())
  token      String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  expiresAt  DateTime
}

model PostDetail {
  id         String    @id @default(cuid())
  desc       String
  utilities  String
  pet        String?
  income     String?
  size       Int?
  school     Int?
  bus        Int?
  restaurant Int?

  postId     String    @unique
  post       Post      @relation(fields: [postId], references: [id])
}

enum Role {
  ADMIN
  BUYER
  SELLER
  AGENT
}

enum Type {
  BUY
  RENT
}

enum Property {
  apartment
  house
  condo
  land
}

enum City {
  AddisAbaba
  Adama
  BahirDar
  Mekelle
  DireDawa
  Hawassa
  Jimma
  Gondar
  Dessie
  Jijiga
}
